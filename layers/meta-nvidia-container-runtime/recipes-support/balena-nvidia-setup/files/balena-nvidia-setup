#!/bin/sh
# Boot-time NVIDIA setup for balena-engine, legacy `--runtime=nvidia` route only.
# Runs as a oneshot Before=balena.service. See docs/design.md#the-boot-oneshot.
#
# There is deliberately no CDI here: no `nvidia-ctk cdi generate`, no
# features.cdi toggle, no spec post-processing. CDI is a later cycle.
set -e

DAEMON_JSON=/etc/docker/daemon.json
NVCT_CFG=/run/nvidia-container-runtime/config.toml
DEV_WAIT_SECS=30

log() { echo "balena-nvidia-setup: $*"; }

# 1. Wait for the GPU devnodes.
#
#    Has to be a poll: L4T's /dev/nvidia* are kernel-direct devtmpfs entries and
#    bypass udev, so a systemd .device unit never activates. A timeout is a
#    warning, not a failure - the config we write is still correct.
i=0
while [ "${i}" -lt "${DEV_WAIT_SECS}" ]; do
    # /dev/nvidia0 on discrete-style enumeration, /dev/nvidiactl always.
    if [ -e /dev/nvidiactl ] || [ -e /dev/nvidia0 ]; then
        break
    fi
    i=$((i + 1))
    sleep 1
done
if [ "${i}" -ge "${DEV_WAIT_SECS}" ]; then
    log "WARNING: no /dev/nvidiactl or /dev/nvidia0 after ${DEV_WAIT_SECS}s; configuring anyway"
else
    log "GPU devnodes present after ${i}s"
fi

# 2. Register the legacy `nvidia` runtime in the engine's daemon.json.
#
#    Deliberately NO --cdi.enabled: that flips the registered runtime into CDI
#    mode. We want `nvidia` to stay the classic libnvidia-container hook path.
#    Ordered After=bind-etc-docker.service, or this write hits EROFS.
mkdir -p "$(dirname "${DAEMON_JSON}")"
/usr/bin/nvidia-ctk runtime configure \
    --runtime=docker \
    --config="${DAEMON_JSON}"
log "registered nvidia runtime in ${DAEMON_JSON}"

# 3. Add balena-runc to the runtime candidate list, and force csv mode.
#
#    balena-engine ships `balena-runc`, not `runc`, so the default candidate
#    list fails with "no runtime binary found from candidate list".
#
#    mode=csv is essential and not optional: the default `auto` resolves to the
#    NVML platform because this extension ships libnvidia-ml, and the NVML path
#    never reads the CSVs - so nothing is mounted at all. See docs/design.md.
#
#    config.toml lives in /run and is regenerated by nvidia-container-setup.service
#    every boot, so this must be reapplied each time.
if [ -e "${NVCT_CFG}" ]; then
    /usr/bin/nvidia-ctk config --in-place \
        --config="${NVCT_CFG}" \
        --set nvidia-container-runtime.runtimes=balena-runc:docker-runc:runc:crun \
        --set nvidia-container-runtime.mode=csv
    log "patched ${NVCT_CFG}: balena-runc runtime candidate, mode=csv"
else
    log "WARNING: ${NVCT_CFG} absent; nvidia-container-setup.service did not run?"
fi
